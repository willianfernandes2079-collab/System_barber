# Servidor
PORT=3000
NODE_ENV=development

# Quando true: cria usuários de teste automaticamente e permite mocks
# (WhatsApp, e-mail) sem credenciais reais configuradas.
DEVELOPMENT_MODE=true

# Banco de dados (usado a partir da próxima fase — Prisma/PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres2026barber@localhost:5432/barbearia?schema=public"

# Autenticação — GERE SEGREDOS FORTES E ÚNICOS EM PRODUÇÃO
# Sugestão: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_RESET_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN_REMEMBER=30d
JWT_RESET_EXPIRES_IN=15m

BCRYPT_SALT_ROUNDS=10

# WhatsApp Cloud API (deixe em branco para rodar em modo MOCK)
WHATSAPP_API_URL=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# E-mail (deixe em branco para rodar em modo MOCK)
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=