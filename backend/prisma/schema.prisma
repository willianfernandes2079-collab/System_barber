generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Usuario {
  id         String   @id @default(uuid()) @db.Uuid
  nome       String
  email      String   @unique
  senha_hash String
  telefone   String?
  cargo      String
  ativo      Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  sessoes Sessao[]

  @@map("usuarios")
}

model Sessao {
  id         String   @id @default(uuid()) @db.Uuid
  usuario_id String   @db.Uuid
  jti        String   @unique
  created_at DateTime @default(now())
  expires_at DateTime
  user_agent String?
  ip         String?

  usuario Usuario @relation(fields: [usuario_id], references: [id], onDelete: Cascade)

  @@map("sessoes")
}